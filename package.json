{
  "name": "image-helper",
  "version": "1.1.0",
  "description": "Chrome extension that adds a floating toolbar for downloading large images",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build-dev": "yarn build-dev:chrome && yarn build-dev:firefox",
    "build-dev:chrome": "yarn clean:chrome && BROWSER=chrome webpack --config webpack/webpack.dev.js",
    "build-dev:firefox": "yarn clean:firefox && BROWSER=firefox webpack --config webpack/webpack.dev.js",
    "build-prod": "yarn build-prod:chrome && yarn build-prod:firefox",
    "build-prod:chrome": "yarn clean:chrome && BROWSER=chrome webpack --config webpack/webpack.prod.js",
    "build-prod:firefox": "yarn clean:firefox && BROWSER=firefox webpack --config webpack/webpack.prod.js",
    "clean": "rimraf dist",
    "clean:chrome": "rimraf dist/chrome",
    "clean:firefox": "rimraf dist/firefox",
    "dev": "BROWSER=chrome webpack --config webpack/webpack.dev.js --watch",
    "dev:firefox": "BROWSER=firefox webpack --config webpack/webpack.dev.js --watch",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "typecheck": "tsc --noEmit --p tsconfig.json"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.5.2",
    "@types/react": "^18.0.29",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.3",
    "babel-plugin-react-require": "^4.0.2",
    "copy-webpack-plugin": "^9.0.1",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.6.2",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.39",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.0",
    "react-require": "^1.0.1",
    "rimraf": "^3.0.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "ts-loader": "^8.0.0",
    "typescript": "^5.3.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^4.0.0",
    "webpack-merge": "^5.0.0"
  }
}
